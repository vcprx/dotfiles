{
  "show_edit_predictions": false,
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato"
  },
  "buffer_font_family": "Source Code Pro",
  "buffer_font_size": 13.5,
  "ui_font_size": 13.5,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "tab_size": 2,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "languages": {
    "PHP": {
      "language_servers": ["intelephense", "!phpactor", "..."]
    }
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "completion": {
          "insertUseDeclaration": true,
          "fullyQualifyGlobalConstantsAndFunctions": false
        }
      }
    }
  },
  "context_servers": {
    "MCP_DOCKER": {
      "enabled": true,
      "command": "docker",
      "args": ["mcp", "gateway", "run", "--profile", "default"]
    }
  }
}
